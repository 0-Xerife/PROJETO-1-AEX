{
  "name": "@aex/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:exercises": "node --experimental-strip-types --test tests/exercises.test.mjs",
    "test:progression": "node --experimental-strip-types --test tests/progression.test.mjs",
    "test:training": "node --experimental-strip-types --test tests/training.test.mjs",
    "doctor": "expo-doctor",
    "patch:dependencies": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@aex/types": "0.1.0",
    "@expo/dom-webview": "58.0.2",
    "@expo/log-box": "58.0.12",
    "@expo/metro-runtime": "58.0.14",
    "expo": "58.0.16",
    "expo-constants": "58.0.12",
    "expo-file-system": "58.0.10",
    "expo-linking": "58.0.13",
    "expo-router": "58.0.24",
    "expo-status-bar": "58.0.3",
    "expo-symbols": "58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@aex/config": "0.1.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/xcode": "3.0.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "expo-doctor": "1.21.5",
    "patch-package": "8.0.1",
    "typescript": "6.0.3"
  }
}
